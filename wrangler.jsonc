{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carcompare",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Explicit so the workers.dev URL stays on now that `routes` is set.
  "workers_dev": true,
  "routes": [
    // Cloudflare creates and manages the DNS record and certificate for this hostname.
    { "pattern": "carcompare.oscarpurtell.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "assets": {
    // Built SPA from `vite build`. Unknown paths fall back to index.html.
    "not_found_handling": "single-page-application",
    // Only /api/* hits the Worker; everything else is served straight from static assets.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // gemini | openai | anthropic | zai | custom. The API key is a secret: `npx wrangler secret put AI_API_KEY`.
    // Gemini with Google Search grounding: 2.5 Flash has a free grounded allowance (500 requests/day
    // on the free tier). If your key can't use 2.5, set AI_MODEL to a Gemini 3 Flash model (grounding
    // needs billing there: 5,000 free prompts/month, then paid).
    "AI_PROVIDER": "gemini",
    "AI_MODEL": "gemini-2.5-flash"
  },
  "ratelimits": [
    {
      "name": "RESEARCH_RATE_LIMITER",
      "namespace_id": "1001",
      // 5 AI research calls per minute per IP — protects the API key from abuse.
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
